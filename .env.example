# Jeff environment template. Copy to .env.local for local development.
# NEVER commit .env.local. NEVER paste real values into chat, issues, or logs.
# Sensitive values belong in Vercel → Project → Settings → Environment Variables (mark Sensitive).

# --- Application ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# demo | live  (demo shows sample data; live hides it)
JEFF_MODE=demo

# --- Supabase ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Bypasses RLS. Sensitive.
SUPABASE_SECRET_KEY=

# --- Owner identity (single-user app) ------------------------------------
OWNER_EMAIL=noah@bizgrips.com
# Exact Supabase Auth user UUID for the owner. Required in production.
OWNER_USER_ID=

# --- Credential encryption ------------------------------------------------
# 32 random bytes, base64 encoded. Generate with: npm run key:generate
# Sensitive. Rotating it invalidates stored connection secrets.
JEFF_CREDENTIAL_ENCRYPTION_KEY=

# --- Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=
JEFF_MODEL=claude-opus-5
# Hard daily cap on estimated Ask Jeff spend (USD, UTC day). Jeff refuses new AI calls past it.
JEFF_DAILY_BUDGET_USD=2.00

# --- Scheduled sync (Vercel Cron) --------------------------------------------
# Vercel sets CRON_SECRET automatically when a cron is configured; locally use any random string.
CRON_SECRET=

# --- OAuth providers (Sensitive: the *_SECRET values) ---------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration id (non-secret). Leave empty to use the classic scope flow.
META_LOGIN_CONFIG_ID=
# Optional comma list to narrow requested Meta permissions to those added to the app, e.g. ads_read,read_insights,business_management
META_SCOPES=

# --- Stripe (restricted read-only key is entered in the protected UI form, not here)
STRIPE_WEBHOOK_SECRET=

# --- Plaid ---------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- GitHub App ----------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents, base64 encoded on one line. Sensitive.
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_WEBHOOK_SECRET=

# --- n8n -----------------------------------------------------------------
N8N_BASE_URL=
N8N_API_KEY=

# --- Web Push (installed PWA notifications) -------------------------------
# Generate once with: npx web-push generate-vapid-keys
# The public key is safe to ship to the browser; the private key is Sensitive.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noah@bizgrips.com

# --- BizGrips Client Portal (read-only export feed) -----------------------
PORTAL_BASE_URL=https://portal.bizgrips.com
# Same value as the portal's JEFF_EXPORT_TOKEN. Sensitive.
PORTAL_EXPORT_TOKEN=
